# ==============================================================================
# ALI WELEKHASIA MUSIC - CLOUDFLARE STREAM LIVE CONFIGURATION
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# These variables are SERVER-SIDE SECRETS.
# DO NOT commit actual API tokens to git.
# DO NOT expose them in public JavaScript, HTML, or client-side storage.
#
# Configure these in your Cloudflare Pages Dashboard:
# Project -> Settings -> Environment Variables -> Production
# ==============================================================================

# 1. Cloudflare Account ID (Found in Cloudflare Dashboard URL or Overview tab)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# 2. Cloudflare Stream API Token
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Permissions required:
# - Account.Stream: Edit
# - Account.Account Analytics: Read
CLOUDFLARE_STREAM_API_TOKEN=your_cloudflare_stream_api_token_here

# 3. Optional: Specific Pre-existing Cloudflare Live Input UID
CLOUDFLARE_LIVE_INPUT_ID=

# 4. Optional: Admin Server-Side Secret Key for API authorization
ADMIN_API_SECRET=your_admin_secret_phrase_here
